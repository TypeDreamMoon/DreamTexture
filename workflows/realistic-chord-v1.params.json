{
  "id": "realistic-chord-v1",
  "version": 1,
  "name": "写实风格 · CHORD 分解",
  "style": "realistic",
  "description": "SDXL 出无缝纹理，交给 Ubisoft CHORD 一步分解出 BaseColor/Normal/Roughness/Metallic，再由法线反推高度、派生 AO 并打包 ORM。",
  "template": "realistic-chord-v1.json",
  "resolution": 1024,
  "tileable": true,

  "license_notice": {
    "component": "CHORD (dt.pbr_estimate / dt.chord_model)",
    "license": "Ubisoft Machine Learning License (Research-Only, Copyleft)",
    "commercial": false,
    "replaceable_segment": "dt.pbr_estimate",
    "alternatives": ["Marigold IID appearance (OpenRAIL++)", "PBRFusion4 (Apache 2.0)"]
  },

  "model_requirements": [
    {
      "kind": "checkpoint",
      "file": "Juggernaut-XL-v9.safetensors",
      "dir": "checkpoints",
      "size_bytes": 7105348188,
      "source": "https://huggingface.co/RunDiffusion/Juggernaut-XL-v9",
      "download_url": "https://huggingface.co/RunDiffusion/Juggernaut-XL-v9/resolve/main/Juggernaut-XL_v9_RunDiffusionPhoto_v2.safetensors",
      "auth": "none"
    },
    {
      "kind": "checkpoint",
      "file": "chord_v1.safetensors",
      "dir": "checkpoints",
      "size_bytes": 2761211350,
      "source": "https://huggingface.co/Ubisoft/ubisoft-laforge-chord",
      "download_url": "https://huggingface.co/Ubisoft/ubisoft-laforge-chord/resolve/main/chord_v1.safetensors",
      "auth": "hf-gated",
      "note": "gated=auto：先登录 HuggingFace 并在模型页同意协议，再在设置里填好 HF 令牌即可自动下载"
    }
  ],

  "node_packs": ["ComfyUI-Chord", "ComfyUI-seamless-tiling", "ComfyUI-TextureAlchemy"],

  "params": [
    { "key": "prompt", "label": "提示词", "type": "string", "multiline": true,
      "target": "dt.positive.text",
      "prefix": "texture of ",
      "suffix": ", top down view, seamless tileable, orthographic, flat even lighting, no shadows",
      "default": "large old broken rocks with moss",
      "note": "CHORD 对平光输入敏感，后缀的平光约束不要去掉" },
    { "key": "negative", "label": "负面词", "type": "string", "multiline": true,
      "target": "dt.negative.text",
      "default": "perspective, vignette, cast shadow, specular highlight, blurry, watermark, text, border" },
    { "key": "resolution", "label": "分辨率", "type": "enum", "options": [768, 1024],
      "target": ["dt.latent.width", "dt.latent.height"],
      "default": 1024,
      "note": "CHORD 最佳工作分辨率为 1024" },
    { "key": "seed", "label": "种子", "type": "int", "target": "dt.sampler.seed", "default": -1 },
    { "key": "reference", "label": "参考图", "type": "image",
      "target": "dt.reference_image.image",
      "rewire_when_set": { "node": "dt.sampler", "input": "latent_image", "source": "dt.reference_encode", "slot": 0 },
      "drop_when_empty": ["dt.reference_image", "dt.reference_scale", "dt.reference_encode"],
      "note": "留空为纯文生图。给了参考图就变成在它基础上重绘，重绘幅度在高级参数里调" }
  ],

  "advanced": [
    { "key": "steps", "label": "步数", "type": "int", "min": 10, "max": 60, "target": "dt.sampler.steps", "default": 30 },
    { "key": "cfg", "label": "CFG", "type": "float", "min": 1, "max": 15, "target": "dt.sampler.cfg", "default": 7 },
    { "key": "sampler", "label": "采样器", "type": "string", "target": "dt.sampler.sampler_name", "default": "dpmpp_2m" },
    { "key": "scheduler", "label": "调度器", "type": "string", "target": "dt.sampler.scheduler", "default": "karras" },
    { "key": "denoise", "label": "重绘幅度", "type": "float", "min": 0.1, "max": 1.0,
      "target": "dt.sampler.denoise", "default": 1.0,
      "note": "仅在给了参考图时有意义。0.3~0.5 保留原图结构做翻新，0.6~0.8 只借大色调，1.0 等于无视参考图" },
    { "key": "reference_size", "label": "参考图缩放", "type": "enum", "options": [768, 1024],
      "target": ["dt.reference_scale.width", "dt.reference_scale.height"], "default": 1024,
      "note": "参考图会先居中裁切缩放到这个尺寸，应与出图分辨率一致" },
    { "key": "ao_radius", "label": "AO 半径", "type": "int", "min": 4, "max": 64,
      "target": "dt.derive_ao.radius", "default": 36 },
    { "key": "ao_strength", "label": "AO 强度", "type": "float", "min": 0, "max": 3,
      "target": "dt.derive_ao.strength", "default": 2.2 }
  ],

  "outputs": {
    "source":    { "node": "dt.out.source",    "colorspace": "srgb", "role": "reference",
                   "note": "未经分解的原始生成图，仅作对照留档" },
    "basecolor": { "node": "dt.out.basecolor", "colorspace": "srgb" },
    "normal":    { "node": "dt.out.normal",    "colorspace": "linear", "y": "directx",
                   "note": "CHORD 原生输出为 OpenGL(Y+)，已实测确认（corr(G-0.5, grad_y) = -0.91）；工作流内经 dt.normal_to_ue 转成 DirectX，与手绘管线统一为 UE 原生方向" },
    "roughness": { "node": "dt.out.roughness", "colorspace": "linear" },
    "metallic":  { "node": "dt.out.metallic",  "colorspace": "linear" },
    "ao":        { "node": "dt.out.ao",        "colorspace": "linear" },
    "height":    { "node": "dt.out.height",    "colorspace": "linear" },
    "orm":       { "node": "dt.out.orm",       "colorspace": "linear", "packing": "R=ao,G=roughness,B=metallic" }
  }
}
