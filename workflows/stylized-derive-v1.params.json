{
  "id": "stylized-derive-v1",
  "version": 1,
  "name": "手绘风格 · 传统派生",
  "style": "stylized",
  "description": "SDXL + 手绘 LoRA 出无缝底图，再用亮度派生高度/法线/AO/粗糙度。手绘素材对写实分解模型属于分布外，用可解释的传统派生更可控。",
  "template": "stylized-derive-v1.json",
  "resolution": 1024,
  "tileable": true,

  "model_requirements": [
    {
      "kind": "checkpoint",
      "file": "Juggernaut-XL-v9.safetensors",
      "dir": "checkpoints",
      "size_bytes": 7105348188,
      "source": "https://huggingface.co/RunDiffusion/Juggernaut-XL-v9",
      "download_url": "https://huggingface.co/RunDiffusion/Juggernaut-XL-v9/resolve/main/Juggernaut-XL_v9_RunDiffusionPhoto_v2.safetensors",
      "auth": "none"
    },
    {
      "kind": "lora",
      "file": "HandPainted2D-Seamless-SDXL.safetensors",
      "dir": "loras",
      "size_bytes": 228455996,
      "source": "https://civitai.com/models/483692",
      "download_url": "https://civitai.com/api/download/models/537948?fileId=454676",
      "auth": "civitai-login",
      "note": "Civitai 要求登录才能下载：在设置里填好 Civitai 令牌即可自动下，否则请在浏览器中下载后改名放入 loras 目录。触发词 2d seamless hand-painted texture"
    }
  ],

  "node_packs": ["ComfyUI-seamless-tiling", "ComfyUI-TextureAlchemy"],

  "params": [
    { "key": "prompt", "label": "提示词", "type": "string", "multiline": true,
      "target": "dt.positive.text",
      "prefix": "2d seamless hand-painted texture, ",
      "suffix": ", top down view, seamless tileable, flat even lighting, no shadows",
      "default": "stylized hand painted stone bricks with moss" },
    { "key": "negative", "label": "负面词", "type": "string", "multiline": true,
      "target": "dt.negative.text",
      "default": "photo, photorealistic, 3d render, perspective, vignette, cast shadow, specular highlight, blurry, watermark, text" },
    { "key": "resolution", "label": "分辨率", "type": "enum", "options": [512, 768, 1024],
      "target": ["dt.latent.width", "dt.latent.height", "dt.metallic_const.width", "dt.metallic_const.height"],
      "default": 1024 },
    { "key": "seed", "label": "种子", "type": "int", "target": "dt.sampler.seed", "default": -1,
      "note": "-1 表示每个变体随机" },
    { "key": "reference", "label": "参考图", "type": "image",
      "target": "dt.reference_image.image",
      "rewire_when_set": { "node": "dt.sampler", "input": "latent_image", "source": "dt.reference_encode", "slot": 0 },
      "drop_when_empty": ["dt.reference_image", "dt.reference_scale", "dt.reference_encode"],
      "note": "留空为纯文生图。给了参考图就变成在它基础上重绘，重绘幅度在高级参数里调" }
  ],

  "advanced": [
    { "key": "steps", "label": "步数", "type": "int", "min": 10, "max": 60, "target": "dt.sampler.steps", "default": 30 },
    { "key": "cfg", "label": "CFG", "type": "float", "min": 1, "max": 15, "target": "dt.sampler.cfg", "default": 7 },
    { "key": "sampler", "label": "采样器", "type": "string", "target": "dt.sampler.sampler_name", "default": "dpmpp_2m" },
    { "key": "scheduler", "label": "调度器", "type": "string", "target": "dt.sampler.scheduler", "default": "karras" },
    { "key": "denoise", "label": "重绘幅度", "type": "float", "min": 0.1, "max": 1.0,
      "target": "dt.sampler.denoise", "default": 1.0,
      "note": "仅在给了参考图时有意义。手绘化改造建议 0.6~0.75，太低会保留原图的写实光影" },
    { "key": "reference_size", "label": "参考图缩放", "type": "enum", "options": [512, 768, 1024],
      "target": ["dt.reference_scale.width", "dt.reference_scale.height"], "default": 1024,
      "note": "参考图会先居中裁切缩放到这个尺寸，应与出图分辨率一致" },
    { "key": "lora_strength", "label": "风格强度", "type": "float", "min": 0, "max": 1.5,
      "target": ["dt.style_lora.strength_model", "dt.style_lora.strength_clip"], "default": 0.85,
      "bypass_when_zero": { "node": "dt.style_lora", "passthrough": ["model", "clip"] },
      "note": "设为 0 时摘掉 LoRA 节点，等价于只用底模" },

    { "key": "height_contrast", "label": "高度对比", "type": "float", "min": 1.0, "max": 3.0,
      "target": "dt.height_contrast.amount", "default": 2.0,
      "note": "手绘素材本身对比度低，派生需要比写实更高的增益；超过 2.4 高度暗部会压死" },
    { "key": "height_invert", "label": "高度反相", "type": "bool",
      "target": "dt.height_normalize.invert", "default": false },
    { "key": "normal_strength", "label": "法线强度", "type": "float", "min": 0.1, "max": 4.0,
      "target": "dt.derive_normal.strength", "default": 2.2 },
    { "key": "normal_format", "label": "法线格式", "type": "enum", "options": ["DirectX", "OpenGL"],
      "target": "dt.derive_normal.output_format", "default": "DirectX",
      "note": "DirectX = Y 向下，UE/Maya 惯例；OpenGL = Y 向上，Unity/Blender/Three.js 惯例" },
    { "key": "ao_radius", "label": "AO 半径", "type": "int", "min": 4, "max": 64,
      "target": "dt.derive_ao.radius", "default": 44 },
    { "key": "ao_strength", "label": "AO 强度", "type": "float", "min": 0, "max": 3,
      "target": "dt.derive_ao.strength", "default": 2.6 },
    { "key": "roughness_min", "label": "粗糙度下限", "type": "float", "min": 0, "max": 1,
      "target": "dt.derive_roughness.output_white", "default": 0.6 },
    { "key": "roughness_max", "label": "粗糙度上限", "type": "float", "min": 0, "max": 1,
      "target": "dt.derive_roughness.output_black", "default": 0.9,
      "note": "output_black > output_white 即为反相映射：暗处更粗糙" },
    { "key": "metallic_const", "label": "金属度常数", "type": "int", "min": 0, "max": 255,
      "target": "dt.metallic_const.color", "default": 0 }
  ],

  "outputs": {
    "basecolor": { "node": "dt.out.basecolor", "colorspace": "srgb" },
    "normal":    { "node": "dt.out.normal",    "colorspace": "linear", "y_from_param": "normal_format" },
    "roughness": { "node": "dt.out.roughness", "colorspace": "linear" },
    "metallic":  { "node": "dt.out.metallic",  "colorspace": "linear" },
    "ao":        { "node": "dt.out.ao",        "colorspace": "linear" },
    "height":    { "node": "dt.out.height",    "colorspace": "linear" },
    "orm":       { "node": "dt.out.orm",       "colorspace": "linear", "packing": "R=ao,G=roughness,B=metallic" }
  }
}
