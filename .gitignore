__pycache__/
*.pyc

# 运行时产物与本地配置
/runtime/
/output/
/data/
configs/local.*
# 访问令牌与自定义接口地址，只存本机
configs/secrets.json
configs/secrets.json.bak-*
*.db
*.db-wal
*.db-shm
*.log
# 后端日志（含轮转出来的 .log.1，*.log 匹配不到它）
/logs/

# Go
/bin/
dreamtexture.exe
# 交叉编译/中断留下的临时产物
dreamtexture.exe~
*.exe~

# 前端
/web/node_modules/
/web/dist/
# vite 以仓库根为 root 跑过一次留下的缓存，不是产物
/.vite/

# 工具自己的目录，不属于项目
/.claude/

# 注意：internal/web/dist 是**要提交**的。
# 它是 go:embed 的目标，提交之后 clone 下来直接 go build 就能得到可用的
# 二进制，不必先装 node 与 pnpm。代价是每次改前端都会产生一堆压缩后 JS 的
# 变更；看历史时可以用
#   git log --stat -- . ":!internal/web/dist"
# 把它们滤掉。

# Tauri 外壳
/node_modules/
/src-tauri/target/
/src-tauri/gen/
# sidecar 是 go build 出来的产物，不进仓库
/src-tauri/binaries/
