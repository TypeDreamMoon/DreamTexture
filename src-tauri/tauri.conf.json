{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DreamTexture",
  "version": "0.1.0",
  "identifier": "com.typedreammoon.dreamtexture",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "DreamTexture",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/dreamtexture"],
    "resources": {
      "../workflows": "workflows/",
      "../configs/dreamtexture.json": "configs/dreamtexture.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
